* place dummy atoms at the center of each rings
*

set ncycles = 6

read sequence POL @NCYCLES
generate DUM warn

coor set xdir    6.122 ydir   -5.631 zdir    2.648 sele segid dum .and. resi 1 end
coor set xdir    0.177 ydir   -3.299 zdir   -8.676 sele segid dum .and. resi 2 end
coor set xdir    1.574 ydir   -4.938 zdir   -8.590 sele segid dum .and. resi 3 end
coor set xdir   -6.122 ydir    5.631 zdir    2.648 sele segid dum .and. resi 4 end
coor set xdir   -1.574 ydir    4.938 zdir   -8.590 sele segid dum .and. resi 5 end
coor set xdir   -0.177 ydir    3.299 zdir   -8.676 sele segid dum .and. resi 6 end

scalar wmain set 0
scalar wmain set 1.0 sele segid PROA .and. resi 14 end
scalar wmain set 1.0 sele segid PROA .and. resi 19 end
scalar wmain set 1.0 sele segid P2PROA .and. resi 14 end
scalar wmain set 1.0 sele segid P2PROA .and. resi 19 end

return

